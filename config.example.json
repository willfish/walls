{
  "change": {
    "enabled": true,
    "on_start": false,
    "interval_secs": 300,
    "internet_enabled": true,
    "safe_mode": false,
    "change_lock_screen": false,
    "download_preference_ratio": 0.9
  },
  "paths": {
    "cache_dir": "~/.local/share/walls/cache",
    "download_dir": "~/.local/share/walls/downloaded",
    "favorites_dir": "~/.local/share/walls/favorites",
    "fetched_dir": "~/.local/share/walls/fetched",
    "compose_dir": "~/.local/share/walls/wallpaper"
  },
  "quota": {
    "enabled": true,
    "size_mb": 1000
  },
  "apply": {
    "backend": "auto",
    "cosmic": {
      "method": "cosmic-config",
      "config_path": "~/.config/cosmic/com.system76.CosmicBackground/v1/all",
      "use_original_path": false,
      "entry": {
        "rotation_frequency": 0,
        "filter_by_theme": false
      }
    },
    "custom_script": null
  },
  "display": {
    "mode": "os",
    "auto_rotate": false,
    "imagemagick_command": "magick",
    "target_width": null,
    "target_height": null,
    "filters": {
      "enabled": false,
      "command": "magick",
      "filters": [
        { "name": "charcoal", "args": ["-charcoal", "1"] },
        { "name": "edge", "args": ["-edge", "1"] },
        { "name": "paint", "args": ["-paint", "4"] }
      ]
    }
  },
  "selection": {
    "use_landscape_enabled": true,
    "avoid_recent": 50,
    "refetch_when_cache_below": 5,
    "strategy": "random"
  },
  "tray": {
    "accent": "blue",
    "autostart": {
      "desktops": {
        "cosmic": false,
        "kde": false,
        "gnome": false
      }
    }
  },
  "sources": [
    { "enabled": true, "type": "favorites", "label": "The Favorites folder" },
    { "enabled": true, "type": "fetched", "label": "The Fetched folder" },
    {
      "enabled": false,
      "type": "folder",
      "label": "System backgrounds",
      "path": "/usr/share/backgrounds"
    },
    {
      "enabled": false,
      "type": "unsplash",
      "label": "Unsplash nature",
      "query": "nature",
      "orientation": "landscape"
    },
    {
      "enabled": true,
      "type": "bing",
      "label": "Bing Image of the Day"
    },
    {
      "enabled": false,
      "type": "reddit",
      "query": "wallpapers",
      "sort": "hot"
    },
    {
      "enabled": false,
      "type": "apod",
      "label": "NASA Astronomy Picture of the Day"
    },
    {
      "enabled": false,
      "type": "mediarss",
      "label": "NASA Image of the Day (RSS)",
      "url": "https://www.nasa.gov/rss/dyn/lg_image_of_the_day.rss"
    },
    {
      "enabled": false,
      "type": "attribution",
      "label": "Example with attribution",
      "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/5/5b/Elon_Musk_Tesla.jpg/800px-Elon_Musk_Tesla.jpg",
      "source": "Wikimedia",
      "author": "Tesla"
    },
    {
      "enabled": false,
      "type": "json",
      "label": "Demo JSON image feed",
      "url": "https://picsum.photos/id/1015/info",
      "image_path": "$.download_url"
    },
    {
      "enabled": false,
      "type": "pixabay",
      "label": "Pixabay nature",
      "query": "nature",
      "api_key": "YOUR_PIXABAY_KEY_HERE"
    },
    {
      "enabled": false,
      "type": "immich",
      "label": "My Immich",
      "url": "https://immich.example.com",
      "api_key": "YOUR_IMMICH_KEY"
    },
    {
      "enabled": false,
      "type": "spotlight",
      "label": "Windows Spotlight"
    },
    {
      "enabled": false,
      "type": "weighting",
      "label": "High priority weighting",
      "query": "high"
    }
  ],
  "wallhaven": {
    "enabled": true,
    "collections": [],
    "search": {
      "q": "",
      "categories": "111",
      "purity": "100",
      "sorting": "random",
      "order": "desc",
      "atleast": "1920x1080"
    },
    "prefer": "collections_then_search"
  }
}
